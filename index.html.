<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Моя сторінка</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .container {
            display: grid;
            grid-template-columns: 1fr 3fr 1fr;
            grid-template-rows: 80px 350px 100px;
            min-height: 100vh;
        }

        header {
            grid-column: 1 / 4;
            background-color: #08a9e0;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
        }

        aside {
            background-color: #20b34b;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            text-align: center;
        }

        main {
            background-color: white;
            padding: 15px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            background-color: gray;
            min-height: 120px;
            transition: transform 0.3s;
        }

        .card:hover {
            transform: scale(1.08);
        }

        footer {
            grid-column: 1 / 4;
            background-color: yellow;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
        }

        @media (max-width: 600px) {
            .container {
                grid-template-columns: 1fr;
                grid-template-rows: 70px auto auto auto 80px;
            }

            header,
            footer {
                grid-column: 1;
            }

            main {
                grid-template-columns: repeat(2, 1fr);
            }

            aside {
                min-height: 100px;
            }
        }
    </style>
</head>

<body>
    <div class="container">

        <header>HEADER</header>

        <aside>ASIDE LEFT</aside>

        <main>
            <div class="card"></div>
            <div class="card"></div>
            <div class="card"></div>
            <div class="card"></div>
            <div class="card"></div>
            <div class="card"></div>
        </main>

        <aside>ASIDE RIGHT</aside>

        <footer>FOOTER</footer>

    </div>
</body>
</html>
     
